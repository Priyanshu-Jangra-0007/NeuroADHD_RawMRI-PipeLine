{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NeuroADHD RawMRI PoC V2 Provenance Schema",
  "version": "2.0.0",
  "type": "object",
  "required": [
    "timestamp_utc",
    "subject_id",
    "site",
    "cohort_split",
    "software_versions",
    "hardware_execution",
    "validation_gates",
    "output_artifacts"
  ],
  "properties": {
    "timestamp_utc": {
      "type": "string",
      "format": "date-time"
    },
    "subject_id": {
      "type": "string"
    },
    "site": {
      "type": "string"
    },
    "cohort_split": {
      "type": "string",
      "enum": ["train", "test", "synthetic"]
    },
    "software_versions": {
      "type": "object",
      "required": ["dipy", "nilearn", "nibabel", "numpy", "scipy", "scikit-learn"],
      "properties": {
        "dipy": { "type": "string" },
        "nilearn": { "type": "string" },
        "nibabel": { "type": "string" },
        "numpy": { "type": "string" },
        "scipy": { "type": "string" },
        "scikit-learn": { "type": "string" },
        "python": { "type": "string" }
      }
    },
    "hardware_execution": {
      "type": "object",
      "required": ["start_rss_gb", "peak_rss_gb", "peak_memory_ceiling_gb", "runtime_seconds"],
      "properties": {
        "start_rss_gb": { "type": "number" },
        "peak_rss_gb": { "type": "number" },
        "peak_memory_ceiling_gb": { "type": "number" },
        "runtime_seconds": { "type": "number" }
      }
    },
    "validation_gates": {
      "type": "object",
      "required": [
        "gate1_resources",
        "gate2_bids_input",
        "gate3_atlas_grid",
        "gate4_spatial_alignment",
        "gate5_roi_coverage",
        "gate6_feature_concordance"
      ],
      "properties": {
        "gate1_resources": { "type": "object" },
        "gate2_bids_input": { "type": "object" },
        "gate3_atlas_grid": { "type": "object" },
        "gate4_spatial_alignment": { "type": "object" },
        "gate5_roi_coverage": { "type": "object" },
        "gate6_feature_concordance": { "type": "object" }
      }
    },
    "output_artifacts": {
      "type": "object",
      "required": [
        "roi_csv",
        "motion_txt",
        "fd_1d",
        "confounds_tsv",
        "qc_coreg_png",
        "qc_norm_png",
        "qc_parcellation_png"
      ],
      "properties": {
        "roi_csv": { "type": "string" },
        "motion_txt": { "type": "string" },
        "fd_1d": { "type": "string" },
        "confounds_tsv": { "type": "string" },
        "qc_coreg_png": { "type": "string" },
        "qc_norm_png": { "type": "string" },
        "qc_parcellation_png": { "type": "string" }
      }
    }
  }
}

